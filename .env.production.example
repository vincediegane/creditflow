# =====================================================================
# Configuration pour une VRAIE boutique.
#
#   cp .env.production.example .env
#   puis remplacez TOUTES les valeurs marquees « A CHANGER ».
#
# L'application refuse de demarrer si un secret de livraison subsiste.
# =====================================================================

# Mode production : pas de donnees de demonstration, secrets verifies
SPRING_PROFILES_ACTIVE=prod

# --- Base de donnees -------------------------------------------------
DB_NAME=creditflow
DB_USERNAME=creditflow
# A CHANGER — mot de passe long et unique
DB_PASSWORD=
DB_PORT=5432

# --- Ports exposes ---------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3010
FRONTEND_HTTPS_PORT=3443

# --- Securite --------------------------------------------------------
# A CHANGER — 32 caracteres minimum. Exemple de generation :
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=720

# Compte du commercant. Il devra choisir son propre mot de passe
# a la premiere connexion (ADMIN_FORCE_PASSWORD_CHANGE=true).
ADMIN_USERNAME=admin
# A CHANGER — 8 caracteres minimum, communique au commercant
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Proprietaire
ADMIN_FORCE_PASSWORD_CHANGE=true

# --- Boutique --------------------------------------------------------
SHOP_NAME=Nom de la boutique
TZ=Africa/Dakar

# --- Donnees de demonstration ----------------------------------------
# Doit rester false chez un client
DEMO_SEED=false

# --- Sauvegardes -----------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# --- Acces -----------------------------------------------------------
# Ajoutez ici l'adresse reellement utilisee (nom de machine ou IP locale)
CORS_ALLOWED_ORIGINS=http://localhost:3010,https://localhost:3443

# --- Relances automatiques ---------------------------------------------
# A CHANGER uniquement si vous activez WhatsApp — laisser NOTIFICATION_CHANNEL=manual sinon
NOTIFICATION_CHANNEL=manual
NOTIFICATION_DEFAULT_COUNTRY_CODE=+221
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=relance_creditflow
WHATSAPP_TEMPLATE_LANGUAGE_CODE=fr

# --- Formule vendue --------------------------------------------------
# A ALIGNER sur la formule facturee a ce client
PLAN_MULTI_SHOP=true
PLAN_WHATSAPP_AUTO=true

# --- Stockage des documents --------------------------------------------
# STORAGE_S3_* optionnelles tant que STORAGE_PROVIDER=local.
# ATTENTION : basculer STORAGE_PROVIDER vers s3 sur une instance qui a deja des
# fichiers stockes en local ne les migre PAS automatiquement vers S3 (et inversement).
# Les fichiers existants deviennent introuvables tant qu'ils n'ont pas ete copies
# manuellement vers le nouveau fournisseur.
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_PATH_STYLE_ACCESS=false
STORAGE_SIGNED_URL_TTL_SECONDS=300
