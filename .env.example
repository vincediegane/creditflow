# Copiez ce fichier en .env pour personnaliser le deploiement.

# Base de donnees
DB_NAME=creditflow
DB_USERNAME=creditflow
DB_PASSWORD=creditflow
DB_PORT=5432

# Role de migration Flyway (superuser/proprietaire des tables)
DB_MIGRATION_USERNAME=creditflow
DB_MIGRATION_PASSWORD=creditflow

# Role applicatif restreint (utilise par le pool backend, cf. RLS #40)
DB_APP_USERNAME=creditflow_app
DB_APP_PASSWORD=creditflow_app

# Ports exposes
BACKEND_PORT=8080
FRONTEND_PORT=3010

# Securite (CHANGEZ CES VALEURS EN PRODUCTION)
JWT_SECRET=creditflow-super-secret-key-change-me-in-production-0123456789
JWT_EXPIRATION_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Administrateur Boutique

# Boutique
SHOP_NAME=CreditFlow Boutique

# Donnees de demonstration (mettre a false pour demarrer avec une base vide)
DEMO_SEED=true

# Relances automatiques (laisser sur manual pour conserver la copie manuelle)
NOTIFICATION_CHANNEL=manual
NOTIFICATION_DEFAULT_COUNTRY_CODE=+221
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=relance_creditflow
WHATSAPP_TEMPLATE_LANGUAGE_CODE=fr

# Formule vendue a cette instance (Essentiel = false, Pro/Multi-boutiques = true)
PLAN_MULTI_SHOP=true
PLAN_WHATSAPP_AUTO=true

# Stockage des documents (photos clients, pieces jointes). Les variables STORAGE_S3_*
# sont optionnelles tant que STORAGE_PROVIDER=local.
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_PATH_STYLE_ACCESS=false
STORAGE_SIGNED_URL_TTL_SECONDS=300
